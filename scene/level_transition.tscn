[sub_resource type="GDScript" id="GDScript_m83mb"]
script/source = "extends Node2D

var arraypath : Array


@onready var connection = [
	{\"connection\" : $connection1,
	\"prev_icon\": $icon/Hammer,
	\"next_icon\" : $icon/paintroll,
	\"prev_scale\" : Vector2(0.08, 0.08),
	\"next_scale\" : Vector2(1.2, 1.2)
	},
	{\"connection\" : $connection2,
	\"prev_icon\": $icon/paintroll,
	\"next_icon\" : $icon/chainsaw,
	\"prev_scale\" : Vector2(1.0, 1.0),
	\"next_scale\" : Vector2(0.55, 0.55)
	},
	{\"connection\" : $connection3,
	\"prev_icon\": $icon/chainsaw,
	\"next_icon\" : $icon/TapeMeasure,
	\"prev_scale\" : Vector2(0.48, 0.48),
	\"next_scale\" : Vector2(0.13, 0.13)
	}
	]


func start():
	await get_tree().create_timer(1).timeout

	var tw = create_tween()
	tw.set_trans(Tween.TRANS_CIRC)
	tw.tween_property(connection[0][\"prev_icon\"], \"scale\", Vector2(0.1, 0.1), 0.5)
	tw.parallel().tween_property(connection[0][\"prev_icon\"].get_child(0), \"modulate:a\", 1.0, 1)
	await  tw.finished
	await  get_tree().create_timer(1).timeout



func start_path(id:int):
	await get_tree().create_timer(1).timeout
	var data = connection[id]
	var _con: Line2D = data[\"connection\"]
	arraypath = _con.points
	_con.clear_points()
	_con.show()
	await get_tree().create_timer(1).timeout

	var tw = create_tween()
	tw.set_trans(Tween.TRANS_CIRC)
	tw.tween_property(data[\"prev_icon\"], \"scale\", data[\"prev_scale\"], 0.5)

	for point in arraypath:
		var tween = create_tween()
		tween.set_trans(Tween.TRANS_SINE)
		tween.tween_property($Penwrite,\"global_position\", _con.to_global(point), 0.01)
		await tween.finished
		_con.add_point(point)

	var tw2 = create_tween()
	tw2.set_trans(Tween.TRANS_CIRC)
	tw2.tween_property(connection[id].get(\"next_icon\"), \"scale\", data[\"next_scale\"], 0.5)
	tw2.parallel().tween_property(data[\"next_icon\"].get_child(0), \"modulate:a\", 1.0, 1)

	await  tw2.finished
	await  get_tree().create_timer(1).timeout
"

